{
  "name": "@zelthr/topup",
  "version": "1.1.1",
  "description": "TrueMoney gift-code redemption and Thai bank-slip verification: QR decode (PromptPay EMVCo + slip-check Mini-QR with CRC validation), local OCR amount extraction, and Slip Verify/TrueMoney API clients.",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "eng.traineddata",
    "CHANGELOG.md",
    "SECURITY-AUDIT.md"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "build": "tsc && node scripts/esm-wrapper.js",
    "test": "node --test"
  },
  "keywords": [
    "truemoney",
    "topup",
    "thailand",
    "slip",
    "slip-verify",
    "promptpay",
    "emvco",
    "qr",
    "ocr",
    "bank-transfer",
    "verification"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zelthrStudio/topup.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@gutenye/ocr-node": "^1.4.8",
    "@zelthr/qrcode": "^0.1.0",
    "@zelthr/request": "^1.1.2",
    "onnxruntime-node": "1.21.1",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0"
  },
  "overrides": {
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "sharp@0.35.3": true,
    "onnxruntime-node@1.21.1": true,
    "tesseract.js@7.0.0": true
  }
}
