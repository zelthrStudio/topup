{
  "name": "@zelthr/topup",
  "version": "3.1.0",
  "description": "TrueMoney gift-code redemption and Thai bank-slip verification through the zelthrStudio Open API gateway — no local scanning, no native dependencies.",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md",
    "SECURITY-AUDIT.md"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "build": "tsc && node scripts/esm-wrapper.js",
    "test": "node --test"
  },
  "keywords": [
    "truemoney",
    "topup",
    "thailand",
    "slip",
    "slip-verify",
    "bank-transfer",
    "verification",
    "api"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zelthrStudio/topup.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@zelthr/request": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
